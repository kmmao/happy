# Happy Caddy 反向代理配置
# DNS-01 验证 + 非标端口 + 泛域名证书

{
	admin 0.0.0.0:2019
	https_port 2443
	http_port 2080
	acme_dns cloudflare {env.CF_API_TOKEN}
}

# Wildcard TLS snippet — one cert for all *.code.xycloud.info
(cloudflare_tls) {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		propagation_timeout 300s
		propagation_delay 15s
		resolvers 1.1.1.1 8.8.8.8
	}
}

s.sangreal.code.xycloud.info {
	reverse_proxy server:3005 {
		# Flush immediately for WebSocket / SSE / Socket.IO
		flush_interval -1
	}
	import cloudflare_tls
}

w.sangreal.code.xycloud.info {
	reverse_proxy host.docker.internal:8081
	import cloudflare_tls
}

gs.sangreal.code.xycloud.info {
	# Upstream MUST be 172.18.0.1 docker bridge gateway, not host.docker.internal.
	# The latter is hijacked by upstream AUTOPROXY returning fake nginx/1.12.2.
	reverse_proxy 172.18.0.1:80
	import cloudflare_tls
}

agent.sangreal.code.xycloud.info {
	# Agents Anywhere server (SQLite Docker container) exposes host port 5174 -> container 8000
	reverse_proxy host.docker.internal:5174 {
		# Flush immediately for WebSocket (Connector RPC / live logs)
		flush_interval -1
	}
	import cloudflare_tls
}

# Pre-sign wildcard cert so new subdomains are instant
*.code.xycloud.info {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		propagation_timeout 300s
		propagation_delay 15s
		resolvers 1.1.1.1 8.8.8.8
	}
	# No routes — just hold the wildcard cert
	# Actual routing is done by specific site blocks below
	respond "Not Found" 404
}

# Dynamic container sites (ttyd web terminals)
# Files managed by happy-app provision flow via docker exec
import /etc/caddy/sites/*.caddy
