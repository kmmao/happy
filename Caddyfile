# Happy Caddy 反向代理配置
# DNS-01 验证 + 非标端口

{
    admin 0.0.0.0:2019
    https_port 2443
    http_port 2080
    acme_dns cloudflare {env.CF_API_TOKEN}
}

code.xycloud.info {
    handle_path /app/* {
        reverse_proxy host.docker.internal:8081
    }
    handle_path /app {
        reverse_proxy host.docker.internal:8081
    }

    handle {
        reverse_proxy host.docker.internal:3005
    }

    tls {
        dns cloudflare {env.CF_API_TOKEN}
        propagation_timeout 300s
        propagation_delay 15s
        resolvers 1.1.1.1 8.8.8.8
    }
}

# ttyd Web Terminal (port range 7001-7100)
# Each happy-client container maps a unique host port to internal 7681
# Access: https://code.xycloud.info:2443 won't work for ttyd ports,
# so we listen on a separate port range via individual site blocks.
# For now, ttyd is accessible directly via http://{host}:{port}
# To add HTTPS, create a wildcard subdomain: *.t.code.xycloud.info
