# Happy Server 生产环境变量配置
# 将此文件复制为 .env 并填写所有必填项（标有 REQUIRED 的变量）
#
# 生成强随机密钥：openssl rand -hex 32

# ── 域名 ─────────────────────────────────────────────────────────────────────
# [REQUIRED] 你的服务器域名，Caddy 会自动申请 Let's Encrypt 证书
DOMAIN=happy.example.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=happy
# [REQUIRED] 数据库密码（至少 16 位随机字符串）
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=happy

# ── Redis ─────────────────────────────────────────────────────────────────────
# [REQUIRED] Redis 密码
REDIS_PASSWORD=change-me-redis-password

# ── MinIO 对象存储 ────────────────────────────────────────────────────────────
# [REQUIRED] MinIO 管理员凭证
MINIO_ROOT_USER=happyadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=happy

# [REQUIRED] 客户端（浏览器/App）访问文件的公开 URL
# 示例：https://happy.example.com/files（若通过 Caddy 代理 MinIO）
S3_PUBLIC_URL=https://happy.example.com/files

# ── Happy Server 核心配置 ─────────────────────────────────────────────────────
# [REQUIRED] 主密钥，用于 Auth Token 签名和服务端加密（32 字节十六进制）
HANDY_MASTER_SECRET=change-me-run-openssl-rand-hex-32

# ── 访问控制 ──────────────────────────────────────────────────────────────────
# CORS 允许来源，逗号分隔（填写你的 App / Web 客户端地址）
ALLOWED_ORIGINS=https://happy.example.com

# ── GitHub OAuth（可选，用于 GitHub 集成功能）────────────────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URL=https://happy.example.com/api/github/callback

# ── Anthropic API（可选，用于服务端 AI 功能）─────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── 监控（可选）──────────────────────────────────────────────────────────────
# METRICS_ENABLED=true
# METRICS_PORT=9090
