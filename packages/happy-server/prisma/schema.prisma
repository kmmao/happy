// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["relationJoins"]
}

generator json {
    provider = "prisma-json-types-generator"
}

datasource db {
    provider = "postgresql"
}

//
// Account
//

model Account {
    id              String      @id @default(cuid())
    publicKey       String      @unique
    seq             Int         @default(0)
    feedSeq         BigInt      @default(0)
    createdAt       DateTime    @default(now())
    updatedAt       DateTime    @updatedAt
    settings        String?
    settingsVersion Int         @default(0)
    githubUserId    String?     @unique
    githubUser      GithubUser? @relation(fields: [githubUserId], references: [id])

    // Profile
    firstName String?
    lastName  String?
    username  String? @unique
    /// [ImageRef]
    avatar    Json?

    Session             Session[]
    AccountPushToken    AccountPushToken[]
    TerminalAuthRequest TerminalAuthRequest[]
    AccountAuthRequest  AccountAuthRequest[]
    UsageReport         UsageReport[]
    Machine             Machine[]
    UploadedFile        UploadedFile[]
    ServiceAccountToken ServiceAccountToken[]
    RelationshipsFrom   UserRelationship[]    @relation("RelationshipsFrom")
    RelationshipsTo     UserRelationship[]    @relation("RelationshipsTo")
    Artifact            Artifact[]
    AccessKey           AccessKey[]
    UserFeedItem        UserFeedItem[]
    UserKVStore         UserKVStore[]
    WebhookRoute        WebhookRoute[]
    Project             Project[]
    ProvisionToken      ProvisionToken[]
    Task                Task[]
    Skill               Skill[]
    TriggerSchedule     TriggerSchedule[]
    WebhookTrigger      WebhookTrigger[]
    InboxItem           InboxItem[]
    AiBackendProfile    AiBackendProfile[]
}

model AiBackendProfile {
    id              String   @id @default(cuid())
    accountId       String
    account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    profileKey      String
    name            String
    description     String?
    isBuiltIn       Boolean  @default(false)
    encryptedPayload Bytes
    revision        Int      @default(1)
    archivedAt      DateTime?
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    @@index([accountId])
    @@index([accountId, archivedAt])
    @@unique([accountId, profileKey])
    @@unique([accountId, name])
}

model TerminalAuthRequest {
    id                String   @id @default(cuid())
    publicKey         String   @unique
    supportsV2        Boolean  @default(false)
    response          String?
    responseAccountId String?
    responseAccount   Account? @relation(fields: [responseAccountId], references: [id])
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt
}

model AccountAuthRequest {
    id                String   @id @default(cuid())
    publicKey         String   @unique
    response          String?
    responseAccountId String?
    responseAccount   Account? @relation(fields: [responseAccountId], references: [id])
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt
}

//
// Provision Tokens (headless CLI auth for Docker containers)
//

model ProvisionToken {
    id          String    @id @default(cuid())
    label       String?
    accountId   String
    account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
    tokenHash   String    @unique // SHA-256 hash of the bearer token (never store plaintext)
    webappUrl   String?   // Web App auto-login URL (stored at creation)
    ttydUrl     String?   // ttyd Web Terminal URL (stored at creation)
    revokedAt   DateTime?
    createdAt   DateTime  @default(now())

    @@index([accountId])
}

model AccountPushToken {
    id        String   @id @default(cuid())
    accountId String
    account   Account  @relation(fields: [accountId], references: [id])
    token     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([accountId, token])
}

//
// Sessions
//

model Session {
    id                String           @id @default(cuid())
    tag               String
    accountId         String
    account           Account          @relation(fields: [accountId], references: [id])
    projectId         String?
    project           Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
    metadata          String
    metadataVersion   Int              @default(0)
    agentState        String?
    agentStateVersion Int              @default(0)
    preferences        String?          // Encrypted preferences blob, written by App only
    preferencesVersion Int              @default(0)
    dataEncryptionKey Bytes?
    forkedFromSessionId String?          // Happy session ID this was forked from
    parentSessionId   String?          // Parent session ID (e.g. guardian session that spawned this fix agent)
    seq               Int              @default(0)
    active            Boolean          @default(true)
    lastActiveAt      DateTime         @default(now())
    createdAt         DateTime         @default(now())
    updatedAt         DateTime         @updatedAt
    messages          SessionMessage[]
    usageReports      UsageReport[]
    accessKeys        AccessKey[]
    sessionEvents     SessionEvent[]
    knowledgeAccesses KnowledgeAccess[]

    @@unique([accountId, tag])
    @@index([accountId, updatedAt(sort: Desc)])
    @@index([projectId])
}

model SessionMessage {
    id        String   @id @default(cuid())
    sessionId String
    session   Session  @relation(fields: [sessionId], references: [id])
    localId   String?
    seq       Int
    /// [SessionMessageContent]
    content   Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([sessionId, localId])
    @@index([sessionId, seq])
}

//
// Github
//

model GithubUser {
    id        String    @id
    /// [GitHubProfile]
    profile   Json
    token     Bytes?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    Account   Account[]
}

model GithubOrganization {
    id        String   @id
    /// [GitHubOrg]
    profile   Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

//
// Utility
//

model GlobalLock {
    key       String   @id @default(cuid())
    value     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    expiresAt DateTime
}

model RepeatKey {
    key       String   @id
    value     String
    createdAt DateTime @default(now())
    expiresAt DateTime
}

model SimpleCache {
    key       String   @id
    value     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

//
// Usage Reporting
//

model UsageReport {
    id        String   @id @default(cuid())
    key       String
    accountId String
    account   Account  @relation(fields: [accountId], references: [id])
    sessionId String?
    session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
    /// [UsageReportData]
    data      Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([accountId])
    @@index([sessionId])
    @@index([accountId, sessionId, key])
    @@index([accountId, createdAt])
}

//
// Machines
//

model Machine {
    id                 String      @id
    accountId          String
    account            Account     @relation(fields: [accountId], references: [id])
    metadata           String // Encrypted - contains static machine info
    metadataVersion    Int         @default(0)
    daemonState        String? // Encrypted - contains dynamic daemon state
    daemonStateVersion Int         @default(0)
    dataEncryptionKey  Bytes?
    seq                Int         @default(0)
    active             Boolean     @default(true)
    lastActiveAt       DateTime    @default(now())
    createdAt          DateTime    @default(now())
    updatedAt          DateTime    @updatedAt
    accessKeys         AccessKey[]

    @@unique([accountId, id])
    @@index([accountId])
}

model UploadedFile {
    id        String   @id @default(cuid())
    accountId String
    account   Account  @relation(fields: [accountId], references: [id])
    path      String
    width     Int?
    height    Int?
    thumbhash String?
    reuseKey  String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([accountId, path])
    @@index([accountId])
}

model ServiceAccountToken {
    id         String    @id @default(cuid())
    accountId  String
    account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
    vendor     String
    token      Bytes // Encrypted token
    metadata   Json? // Optional vendor metadata
    lastUsedAt DateTime?
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt

    @@unique([accountId, vendor])
    @@index([accountId])
}

//
// Artifacts
//

model Artifact {
    id                String   @id // UUID provided by client
    accountId         String
    account           Account  @relation(fields: [accountId], references: [id])
    header            Bytes // Encrypted header (can contain JSON)
    headerVersion     Int      @default(0)
    body              Bytes // Encrypted body
    bodyVersion       Int      @default(0)
    dataEncryptionKey Bytes // Encryption key for this artifact
    seq               Int      @default(0)
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    @@index([accountId])
    @@index([accountId, updatedAt(sort: Desc)])
}

//
// Access Keys
//

model AccessKey {
    id          String   @id @default(cuid())
    accountId   String
    account     Account  @relation(fields: [accountId], references: [id])
    machineId   String
    machine     Machine  @relation(fields: [accountId, machineId], references: [accountId, id])
    sessionId   String
    session     Session  @relation(fields: [sessionId], references: [id])
    data        String // Encrypted data
    dataVersion Int      @default(0)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@unique([accountId, machineId, sessionId])
    @@index([accountId])
    @@index([sessionId])
    @@index([machineId])
}

//
// Social Network - Relationships
//

enum RelationshipStatus {
    none
    requested
    pending
    friend
    rejected
}

model UserRelationship {
    fromUserId     String
    fromUser       Account            @relation("RelationshipsFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
    toUserId       String
    toUser         Account            @relation("RelationshipsTo", fields: [toUserId], references: [id], onDelete: Cascade)
    status         RelationshipStatus @default(pending)
    createdAt      DateTime           @default(now())
    updatedAt      DateTime           @updatedAt
    acceptedAt     DateTime?
    lastNotifiedAt DateTime?

    @@id([fromUserId, toUserId])
    @@index([toUserId, status])
    @@index([fromUserId, status])
}

//
// Feed
//

model UserFeedItem {
    id        String   @id @default(cuid())
    userId    String
    user      Account  @relation(fields: [userId], references: [id], onDelete: Cascade)
    counter   BigInt
    repeatKey String?
    /// [FeedBody]
    body      Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, counter])
    @@unique([userId, repeatKey])
    @@index([userId, counter(sort: Desc)])
}

//
// Key-Value Storage
//

model UserKVStore {
    id        String   @id @default(cuid())
    accountId String
    account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    key       String   // Unencrypted for indexing
    value     Bytes?   // Encrypted value, null when "deleted"
    version   Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([accountId, key])
    @@index([accountId])
}

//
// Projects
//

model Project {
    id              String    @id @default(cuid())
    accountId       String
    account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

    // Physical location identifier
    machineId       String
    path            String

    // Optional logical association
    repoUrl         String?   // Normalized git remote URL

    // User-defined metadata (encrypted)
    metadata        String?   // Encrypted JSON: { displayName?, color?, notes? }
    metadataVersion Int       @default(0)

    // Supervisor configuration (encrypted)
    supervisorConfig        String?
    supervisorConfigVersion Int       @default(0)

    // Supervisor scheduling (plaintext — Server needs these for scheduling queries)
    supervisorMode                    String?   // "disabled" | "suggest" | "semi-auto" | "auto"
    supervisorScheduleEnabled         Boolean   @default(false)
    supervisorScheduleIntervalHours   Int?
    supervisorNextRunAt               DateTime?
    supervisorDailyRunCount           Int       @default(0)
    supervisorDailyRunCountResetAt    DateTime?
    supervisorEnabledDimensions       String?   // Comma-separated: "security,dependencies,architecture,techDebt,..."
    supervisorPushTriggerEnabled      Boolean   @default(false)
    supervisorNotifyPrefs             String?   // Comma-separated: "onAnalysisComplete,onIssueCreated,onPRCreated,onError" — null means all enabled
    supervisorCustomRules             String?   // User-defined analysis rules (plaintext, appended to prompt)
    fixStrategy                       String?   // "direct" | "pr" — null means "direct" (default)

    // ── ADR-0022 D-1 — autonomous loop discovery ──
    // When set, an AgentLoop (role=supervisor) is auto-started whenever a
    // standalone (non-loop) SupervisorRun completes with healthScore >= the
    // threshold. null = disabled (default). lastAutoLoopStartedAt enforces a
    // configurable debounce so a noisy project doesn't fire repeatedly.
    // autoLoopDebounceMinutes is the window length in minutes (default 1440 =
    // 24h); set to 0 to disable debounce entirely (useful for testing). Reset
    // the cooldown manually via POST /v1/projects/:id/supervisor/autoloop/
    // reset-debounce.
    autoLoopHealthThreshold           Int?
    autoLoopDebounceMinutes           Int       @default(1440)
    lastAutoLoopStartedAt             DateTime?

    // Knowledge base configuration (project-level overrides)
    // null = inherit hardcoded defaults (enabled:false, mode:auto, sensitivity:balanced)
    knowledgeConfig                   String?   // JSON: KnowledgeConfig

    // Lifecycle
    archived        Boolean   @default(false)
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt

    // Relations
    sessions              Session[]
    supervisorRuns        SupervisorRun[]
    agentLoops            AgentLoop[]
    supervisorDimensions  SupervisorDimension[]
    knowledgeEntries      ProjectKnowledge[]
    profile               ProjectProfile?
    tasks                 Task[]
    skills                Skill[]
    triggerSchedules      TriggerSchedule[]
    webhookTriggers       WebhookTrigger[]

    @@unique([accountId, machineId, path])
    @@index([accountId])
    @@index([accountId, archived])
    @@index([supervisorNextRunAt])
}

//
// Supervisor Custom Dimensions (user-defined health analysis dimensions per project)
//

model SupervisorDimension {
    id          String   @id @default(cuid())
    projectId   String
    accountId   String
    key         String   // camelCase auto-generated from title, unique within project
    title       String
    prompt      String
    enabled     Boolean  @default(true)
    sortOrder   Int      @default(0)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@unique([projectId, key])
    @@index([projectId, enabled])
}

//
// Agent Loops (persistent autonomy primitive — see ADR-0022)
//
// Renamed from `SupervisorLoop` in Phase 2 of the AgentLoop convergence. The
// physical table remains `SupervisorLoop` (via @@map) so existing rows and
// foreign keys don't move — Phase 4 will drop the @@map and rename the DB
// table once CLI-side AgentLoops also land here.
//
// The `role` discriminator partitions rows by behaviour:
//   - "supervisor": today's autopilot — analyze → fix → re-analyze, exits on
//                   max_iterations / cost_cap / health_target / etc., produces
//                   SupervisorRun + SupervisorAction.
//   - "generic":    reserved for Phase 3 — CLI-side AgentLoop definitions
//                   (goal-driven, working memory, downstream cascade).
// Existing rows get role='supervisor' from the column default so no data
// migration is needed; new supervisor mutations filter by role='supervisor'
// as a defence in depth against accidental cross-role writes.

model AgentLoop {
    id                      String    @id @default(cuid())
    projectId               String
    project                 Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
    accountId               String

    // ADR-0022 role discriminator. Default 'supervisor' backfills existing
    // SupervisorLoop rows in place; generic-role rows land here in Phase 3.
    role                    String    @default("supervisor")  // supervisor | generic

    // ── Phase 3a generic-role configuration (ADR-0022) ──
    // These columns are only populated for role='generic' rows. They mirror
    // the CLI-side AgentLoopDefinition (packages/happy-cli/.../AgentLoopStore.ts).
    // Supervisor-role rows leave them NULL. Phase 3b will land the CLI
    // pipeline that reads them on daemon boot.

    // Identity
    prompt                  String?                              // The persistent goal prompt the agent re-issues each iteration
    directory               String?                              // Working directory on the machine
    agent                   String?                              // "claude" | "codex" | "gemini"

    // Scheduling
    intervalMs              Int?                                 // Inter-iteration interval (ms); cron expression takes precedence when set
    cronExpression          String?                              // Optional cron — if present, server scheduler computes nextRunAt
    enabled                 Boolean   @default(true)             // Pauseable without changing status; status is the state-machine, enabled is the user toggle
    nextRunAt               BigInt?                              // Server-computed; epoch ms — queried by scheduler to know when to fire

    // Continuity (lets the daemon re-attach to a long-lived session across restarts)
    continuityKey           String?                              // Stable identifier — agent-loop:<id> by convention
    iteration               Int       @default(0)                // Generic-role iteration counter (independent of currentIteration which is supervisor-only)

    // Long-tail config bag. Holds the fields that are arrays / nested
    // objects / rarely-queried scalars: environmentVariables, file/github/ci
    // bridge toggles, eventSourceAllowlist, eventKeywordFilters, goal,
    // currentFocus, lastReflectionSummary, quietHoursStart/End,
    // maxAutoRunsPerDay, maxConsecutiveFailures, retryBackoffMs, cooldownMs,
    // stopOnSuccess, downstreamLoopIds, downstreamTriggerOn, notifyEvents,
    // notificationChannels, notificationWebhookUrl, maxUsdPerRun, maxUsdPerDay,
    // and the CLI-side agent role triplet (roleId/roleName/roleType). Phase 3b
    // / Phase 4 will promote frequently-queried fields out to typed columns
    // as access patterns crystallise.
    genericConfig           Json?                                // see comment above

    // State machine
    status                  String    @default("running")   // running | paused | completed | failed | stopped
    currentPhase            String    @default("idle")      // idle | analyzing | fixing | deciding
    currentIteration        Int       @default(0)

    // Config snapshot (frozen at loop start)
    maxIterations           Int       @default(5)
    costCapUsd              Float?
    healthScoreTarget       Int?                            // Exit when healthScore drops BELOW this (lower = healthier)
    autoApproveThreshold    Int       @default(80)          // confidence >= N → auto-approve
    maxConsecutiveFailures  Int       @default(2)

    // Cumulative metrics
    totalCostUsd            Float     @default(0)
    totalTokens             Int       @default(0)
    totalActionsFound       Int       @default(0)
    totalActionsFixed       Int       @default(0)
    consecutiveFailures     Int       @default(0)

    // ── ADR-0022 C-1 — semantic convergence ──
    // Number of consecutive iterations with zero approvable actions required
    // before the loop exits with `goal_achieved`. Default 1 preserves the
    // legacy `no_new_actions` semantic for in-flight rows; new loops created
    // via startLoop pick a higher value (today: 2) so single-iteration false
    // negatives don't end runs prematurely.
    emptyIterationsToConfirm   Int       @default(1)
    consecutiveEmptyIterations Int       @default(0)

    // Health score snapshots
    initialHealthScore      Int?
    currentHealthScore      Int?

    // Active run reference (convenience, not FK — avoids circular deps)
    activeRunId             String?

    // Exit
    exitReason              String?   // "max_iterations" | "cost_cap" | "health_target" | "no_new_actions" | "consecutive_failures" | "user_stopped" | "timeout"

    // Timeout protection
    maxDurationMinutes      Int       @default(240)         // 4 hours hard cap

    // AI backend profile to use for all runs in this loop
    profileId               String?
    /// [ResolvedRuntimeProfile]
    runtimeProfile          Json?     @map("profileEnvironmentVariables")

    createdAt               DateTime  @default(now())
    updatedAt               DateTime  @updatedAt
    completedAt             DateTime?

    runs                    SupervisorRun[]

    @@index([projectId])
    @@index([projectId, status])
    @@index([accountId, status])
    @@index([role, status])
    // Phase 3a — generic-role scheduler needs to find "enabled loops whose
    // nextRunAt is in the past" cheaply across all accounts. Composite over
    // (role, enabled, nextRunAt) makes that a single index scan.
    @@index([role, enabled, nextRunAt])

    @@map("SupervisorLoop")
}

//
// Supervisor Runs
//

model SupervisorRun {
    id              String    @id @default(cuid())
    projectId       String
    project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
    accountId       String

    trigger         String    // "scheduled" | "manual" | "event" | "research"
    status          String    @default("pending")  // pending | running | completed | failed | cancelled

    // Report stored as Artifact (encrypted), reference by artifactId
    artifactId      String?

    // Competitor research fields (trigger = "research")
    reportTitle     String?
    reportContent   String?
    researchParams  String?   // JSON: { knownCompetitors?: string, focusAreas?: string }

    actionsCount    Int       @default(0)
    issuesCreated   Int       @default(0)
    sessionId       String?   // Claude Code session running the supervisor
    errorMessage    String?

    // Cost tracking
    tokenCount      Int?      // Total tokens consumed by the analysis session
    costUsd         Float?    // Estimated cost in USD
    healthScore     Int?      // Computed health score at run completion

    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt
    completedAt     DateTime?

    // Loop association (optional — null for standalone runs)
    loopId          String?
    loop            AgentLoop?        @relation(fields: [loopId], references: [id], onDelete: SetNull)
    loopIteration   Int?              // Which iteration of the loop this run belongs to
    loopPhase       String?           // "analyzing" | "fixing"

    actions         SupervisorAction[]

    @@index([projectId])
    @@index([projectId, status])
    @@index([accountId, status])
    @@index([projectId, accountId, status])
    @@index([projectId, createdAt(sort: Desc)])
    @@index([loopId])
}

//
// Supervisor Actions (individual findings from a run)
//

model SupervisorAction {
    id              String    @id @default(cuid())
    runId           String
    run             SupervisorRun @relation(fields: [runId], references: [id], onDelete: Cascade)
    projectId       String
    accountId       String

    // Finding metadata (unencrypted — used for filtering/sorting)
    severity        String    // "critical" | "high" | "medium" | "low"
    category        String    // "security" | "dependencies" | "architecture" | "techDebt" | "codeQuality" | "testCoverage"

    // Finding content (encrypted — user-visible text)
    title           String    // Encrypted
    description     String    // Encrypted
    suggestedFix    String?   // Encrypted
    confidence      Int?      // 0-100 AI confidence in suggestedFix

    // Approval workflow
    approval        String    @default("pending")  // pending | approved | skipped | ignored

    // Fix tracking
    fixSessionId    String?   // Claude Code session executing the fix
    fixStatus       String?   // pending | running | completed | failed | analyzed
    fixMode         String?   // "fix" | "analyze-first" — null means "fix"
    issueUrl        String?   // GitHub Issue URL if created

    // Deduplication — tracks last run that detected this issue
    lastSeenRunId   String?

    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt

    @@index([runId])
    @@index([projectId, approval])
    @@index([accountId, approval])
    @@index([projectId, accountId, approval])
    @@index([projectId, category, title, approval])
    @@index([projectId, fixStatus])
    @@index([projectId, accountId, fixStatus, updatedAt(sort: Desc)])
}

//
// Webhooks
//

model WebhookRoute {
    id            String   @id @default(cuid())
    accountId     String
    account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    provider      String // "github" | "gitea" | "gitlab"
    repoUrl       String // Normalized, e.g. "https://github.com/owner/repo"
    webhookSecret Bytes // Server-side encrypted (same as ServiceAccountToken.token)
    apiToken      Bytes? // Server-side encrypted API token for label verification
    labels        String[] // Trigger labels, e.g. ["auto-fix"]
    authors       String[] // Allowed issue authors
    machineId     String // Target machine to dispatch to
    repoPath      String // Local repo path on the target machine
    enabled          Boolean  @default(true)
    remoteWebhookId  String?  // ID of the webhook created on the Git platform

    // Profile binding — same semantics as Task.profileId / WebhookTrigger.profileId.
    profileId       String?

    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    @@unique([accountId, repoUrl])
    @@index([repoUrl])
    @@index([accountId, profileId])
}

model WebhookEvent {
    id           String   @id @default(cuid())
    accountId    String
    provider     String // "github" | "gitea" | "gitlab"
    deliveryId   String // Platform delivery ID for idempotency
    repoUrl      String
    issueNumber  Int
    issueTitle   String
    issueAuthor  String
    issueBody    String   @default("")
    issueLabels  String[]
    issueUrl     String
    status       String   @default("pending") // pending | dispatched | completed | failed | skipped
    errorMessage String?
    machineId    String?
    sessionId    String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@unique([provider, deliveryId])
    @@index([repoUrl, issueNumber])
    @@index([status])
}

//
// Project Knowledge Base (medical record metaphor)
//

model ProjectKnowledge {
    id              String   @id @default(cuid())
    projectId       String
    project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

    // Classification
    entryType       String   // discovery | decision | fix | convention | warning
    category        String?  // user | feedback | project | reference (Claude Code 4-type taxonomy)
    contributorType String   // session | supervisor | user | auto-dream
    action          String   // create | amend | supersede | verify
    status          String   @default("active") // active | superseded | archived

    // Content
    title           String
    content         String   // Encrypted: narrative description
    structured      String?  // Encrypted: JSON {request, findings, analysis, outcome, nextSteps}

    // Metadata
    tags            String   @default("[]")  // JSON array (plaintext for filtering)
    confidence      String   @default("medium") // high | medium | low
    model           String?  // Model that generated this entry
    sessionId       String?  // Source session ID
    affectedFiles   String   @default("[]")  // JSON array
    relatedIds      String   @default("[]")  // JSON array of related entry IDs

    // Embedding (pgvector — Phase 2 semantic search)
    embedding       Unsupported("vector(1024)")?

    // Relations (knowledge evolution)
    supersedesId    String?
    supersedes      ProjectKnowledge? @relation("KnowledgeSupersession", fields: [supersedesId], references: [id])
    supersededBy    ProjectKnowledge[] @relation("KnowledgeSupersession")

    // Graph relations (Phase 3 — replaces relatedIds JSON array)
    relationsFrom   KnowledgeRelation[] @relation("RelationFrom")
    relationsTo     KnowledgeRelation[] @relation("RelationTo")

    // Lifecycle (Phase 2 — decay & archive)
    lastAccessedAt  DateTime?
    accessCount     Int      @default(0)

    // User curation
    pinned          Boolean  @default(false)

    accesses        KnowledgeAccess[]

    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    @@index([projectId, status])
    @@index([projectId, entryType])
    @@index([projectId, category])
    @@index([projectId, createdAt])
    @@index([projectId, status, lastAccessedAt])
}

//
// Knowledge Relation Graph (Phase 3 — multi-type relations)
//

model KnowledgeRelation {
    id             String   @id @default(cuid())

    fromEntryId    String
    fromEntry      ProjectKnowledge @relation("RelationFrom", fields: [fromEntryId], references: [id], onDelete: Cascade)

    toEntryId      String
    toEntry        ProjectKnowledge @relation("RelationTo", fields: [toEntryId], references: [id], onDelete: Cascade)

    relationType   String   // "related" | "contradicts" | "refines" | "combines"
    metadata       String?  // Optional JSON (e.g. LLM merge reasoning)

    createdAt      DateTime @default(now())

    @@unique([fromEntryId, toEntryId, relationType])
    @@index([fromEntryId])
    @@index([toEntryId])
    @@index([relationType])
}

//
// Knowledge Access Log (session-level reference tracking)
//

model KnowledgeAccess {
    id          String   @id @default(cuid())

    sessionId   String
    session     Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    knowledgeId String
    knowledge   ProjectKnowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

    projectId   String
    at          DateTime @default(now())

    // Session-scoped TTL-by-turn (Phase: migrate-out countdown)
    // initialTurns = starting budget at injection; maxTurns = cap for +1 growth; turnsRemaining = live counter.
    // hotStatus: "hot" = still injected in-session, "evicted" = countdown hit zero, entry skipped in future turns.
    initialTurns    Int      @default(5)
    maxTurns        Int      @default(10)
    turnsRemaining  Int      @default(5)
    hitCount        Int      @default(0)
    hotStatus       String   @default("hot") // hot | evicted
    lastHitAt       DateTime?

    @@unique([sessionId, knowledgeId])
    @@index([knowledgeId])
    @@index([projectId, sessionId])
    @@index([sessionId, hotStatus])
}

model ProjectProfile {
    id        String   @id @default(cuid())
    projectId String   @unique
    project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

    content   String   // Encrypted: ProjectProfile JSON
    version   Int      @default(1)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

//
// Tasks (Server-side persistent task queue)
//

model Task {
    id              String    @id @default(cuid())
    accountId       String
    account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
    projectId       String?
    project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
    machineId       String    // Target machine for execution

    // Content (encrypted by App, decrypted by CLI)
    title           String?                         // Human-readable title (set by Planner or user)
    prompt          String
    promptVersion   Int       @default(0)
    directory       String?

    // Execution
    priority        String    @default("user")     // urgent | user | background
    status          String    @default("queued")    // queued | dispatching | running | completed | failed | cancelled
    attempt         Int       @default(0)
    maxAttempts     Int       @default(3)

    // Trigger metadata
    triggerType     String    @default("manual")    // manual | cron | webhook
    triggerRef      String?                         // cron:<scheduleId> | webhook:<triggerId>

    // Profile binding (wire 0.14.0 / schema 2026-04-24)
    // Value is a profile business key: built-in id (e.g. "anthropic") or
    // AiBackendProfile.profileKey under the same accountId. Nullable for
    // backward compatibility; C4 server resolver enforces presence at
    // runtime. NOT NULL constraint is a follow-up migration.
    profileId       String?

    // Worktree isolation (wire 0.17.0 / schema 2026-05-04)
    // When true, the CLI creates a dedicated git worktree at execution time
    // rather than running directly in the task directory.
    worktreeIsolation Boolean @default(false)

    // Execution tracking
    sessionId       String?                         // CLI session spawned for this task
    errorMessage    String?
    dispatchedAt    DateTime?
    completedAt     DateTime?

    // Parent-child relationship for Intent → Steps decomposition
    parentTaskId    String?
    parentTask      Task?    @relation("TaskChildren", fields: [parentTaskId], references: [id], onDelete: SetNull)
    childTasks      Task[]   @relation("TaskChildren")

    // Skill bindings
    skillBindings   TaskSkillBinding[]

    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt

    @@index([accountId, status])
    @@index([accountId, machineId, status])
    @@index([machineId, status])
    @@index([projectId])
    @@index([accountId, createdAt(sort: Desc)])
    @@index([accountId, profileId])
    @@index([parentTaskId])
}

//
// Skills (Reusable instruction templates)
//

model Skill {
    id                String    @id @default(cuid())
    accountId         String
    account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
    projectId         String?                       // null = global skill, set = project-scoped
    project           Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

    name              String
    description       String?
    content           String                        // The instruction template text
    contentVersion    Int       @default(0)

    // Optional attachment references (JSON array of file refs)
    attachments       String    @default("[]")

    // Lineage from Knowledge Base
    sourceKnowledgeId String?                       // ProjectKnowledge.id this was derived from

    archived          Boolean   @default(false)
    createdAt         DateTime  @default(now())
    updatedAt         DateTime  @updatedAt

    // Relations
    taskBindings      TaskSkillBinding[]

    @@unique([accountId, projectId, name])
    @@index([accountId, archived])
    @@index([projectId])
}

//
// Task ↔ Skill binding (many-to-many)
//

model TaskSkillBinding {
    id        String @id @default(cuid())
    taskId    String
    task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
    skillId   String
    skill     Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
    order     Int    @default(0) // Injection order

    @@unique([taskId, skillId])
    @@index([taskId])
    @@index([skillId])
}

//
// Trigger Schedules (Cron-based task creation)
//

model TriggerSchedule {
    id              String    @id @default(cuid())
    accountId       String
    account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
    projectId       String?
    project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
    machineId       String    // Target machine

    name            String?
    prompt          String    // Encrypted: template prompt
    cronExpression  String
    priority        String    @default("background")
    enabled         Boolean   @default(true)

    // Skill bindings (JSON array of skill IDs)
    skillIds        String    @default("[]")

    // Profile binding — see Task.profileId docs. Nullable pending backfill.
    profileId       String?

    // Tracking
    nextRunAt       DateTime?
    lastRunAt       DateTime?
    lastTaskId      String?
    runCount        Int       @default(0)

    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt

    @@index([accountId, machineId, enabled])
    @@index([nextRunAt])
    @@index([accountId, profileId])
}

//
// Generic Webhook Triggers (external system → Task)
//

model WebhookTrigger {
    id              String    @id @default(cuid())
    accountId       String
    account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
    projectId       String?
    project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
    machineId       String    // Target machine

    name            String?
    slug            String    @unique              // URL slug: /v1/triggers/:slug
    secretHash      String                         // SHA-256 hash of bearer token
    prompt          String                         // Encrypted: template prompt (can use {{payload}} placeholder)
    priority        String    @default("background")
    enabled         Boolean   @default(true)

    // Skill bindings (JSON array of skill IDs)
    skillIds        String    @default("[]")

    // Profile binding — see Task.profileId docs. Nullable pending backfill.
    profileId       String?

    // Stats
    lastTriggeredAt DateTime?
    triggerCount    Int       @default(0)

    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt

    @@index([accountId, machineId])
    @@index([accountId, profileId])
}

//
// Inbox
//

model InboxItem {
    id          String   @id @default(cuid())

    // Owner
    accountId   String
    account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

    // Classification
    category    String   // task | trigger | supervisor | session | knowledge | system
    eventType   String   // e.g. "task.completed", "trigger.cron.fired"
    severity    String   @default("info") // info | warning | error

    // Content
    title       String
    body        String?

    // State
    read        Boolean  @default(false)

    // Reference (polymorphic — no FK, string-based)
    referenceUrl String? // Deep link path, e.g. "/machine/xxx/tasks"
    refType     String?  // "task" | "trigger" | "session" | ...
    refId       String?  // ID of referenced entity

    // Dedup: same groupKey within 1 hour → skip creation
    groupKey    String?

    createdAt   DateTime @default(now())

    @@index([accountId, read, createdAt(sort: Desc)])
    @@index([accountId, category, createdAt(sort: Desc)])
    @@index([groupKey, createdAt])
}

//
// Session Timeline
//

model SessionEvent {
    id          String   @id @default(cuid())

    // Parent session
    sessionId   String
    session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    // Event classification
    eventType   String   // file_edit | bash_command | tool_call | git_operation | error | session_start | session_end

    // Content (plaintext — CLI reports metadata, not encrypted messages)
    summary     String   // Human-readable one-liner, e.g. "Edited src/index.ts"
    detail      Json?    // Structured metadata: { path, diff, command, exitCode, ... }

    createdAt   DateTime @default(now())

    @@index([sessionId, createdAt(sort: Desc)])
    @@index([sessionId, eventType])
}

//
// World Suggestion — server-generated next-step proposals (Phase C)
//
