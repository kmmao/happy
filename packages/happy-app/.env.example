# Happy App 环境变量配置
# 将此文件复制为 .env（.env 已被 .gitignore 忽略，不会入库）
#
# 注意：所有 EXPO_PUBLIC_* 变量都会被 Metro 内联进 JS bundle，
# 可以从已发布的安装包里提取出来。只放非敏感值，或仅用于本地开发。

# ── ElevenLabs 语音（voiceProvider = elevenlabs 时使用）────────────────────────
# 平台侧集中管理的 Agent ID，不是密钥
EXPO_PUBLIC_ELEVENLABS_AGENT_ID=

# ── Realtime 语音网关（voiceProvider = openai-realtime 时使用）─────────────────
# sub2api 等兼容 OpenAI Realtime 的网关。填不填 /v1 都可以，代码会归一化。
# 这些只是默认值——设置页里填的值优先级更高。
EXPO_PUBLIC_REALTIME_GATEWAY_URL=https://your-sub2api.example.com

# [仅本地开发] 网关 API Key。会进 bundle，发布构建请留空，
# 让每个用户在「设置 → 语音」里填自己的 key（走 E2E 加密同步）。
# 对应的 group 需满足：platform = OpenAI 且已开启 AllowLive。
EXPO_PUBLIC_REALTIME_GATEWAY_API_KEY=

# 留空则由网关选择默认音色。
# 注意：这里没有「模型」配置项 —— ChatGPT 的 Codex realtime 会话由账号决定模型，
# 显式指定会被上游拒绝（"Field `session.model` is not allowed"）。
EXPO_PUBLIC_REALTIME_VOICE=
