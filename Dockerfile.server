# Stage 1: install dependencies (only server + wire workspaces)
FROM node:20 AS deps

# Install build dependencies (python3/make/g++ needed for native addons like sharp)
RUN apt-get update && apt-get install -y python3 ffmpeg make g++ build-essential && rm -rf /var/lib/apt/lists/*

WORKDIR /repo

COPY package.json yarn.lock ./
COPY scripts ./scripts
COPY patches ./patches

# Trim workspaces to only server + wire (skip app/cli/agent and their ~1.3GB deps)
RUN node -e "\
  const p = JSON.parse(require('fs').readFileSync('package.json','utf8'));\
  p.workspaces.packages = ['packages/happy-server','packages/happy-wire'];\
  delete p.workspaces.nohoist;\
  require('fs').writeFileSync('package.json', JSON.stringify(p, null, 4));"

RUN mkdir -p packages/happy-server packages/happy-wire

COPY packages/happy-server/package.json packages/happy-server/
COPY packages/happy-wire/package.json packages/happy-wire/
COPY packages/happy-server/prisma packages/happy-server/prisma

RUN SKIP_HAPPY_WIRE_BUILD=1 yarn install --frozen-lockfile --ignore-engines

# Stage 2: build the server
FROM deps AS builder

COPY packages/happy-wire ./packages/happy-wire
COPY packages/happy-server ./packages/happy-server

RUN yarn workspace @kmmao/happy-wire build
RUN yarn workspace happy-server generate

# Stage 3: runtime (slim base image, ~200MB vs ~1GB for node:20)
FROM node:20-slim AS runner

WORKDIR /repo

# Runtime dependencies only (no python3/make/g++ — those are build-time only)
RUN apt-get update && apt-get install -y ffmpeg && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV TZ=Asia/Shanghai

COPY --from=builder /repo/package.json /repo/package.json
COPY --from=builder /repo/node_modules /repo/node_modules
COPY --from=builder /repo/packages/happy-wire /repo/packages/happy-wire
COPY --from=builder /repo/packages/happy-server /repo/packages/happy-server

EXPOSE 3005

CMD ["yarn", "--cwd", "packages/happy-server", "start"]
