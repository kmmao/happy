# Docker Compose 运行时可选：复制为 .env.docker 或在当前 shell 中 export
# 若不设置 HANDY_MASTER_SECRET，compose 会使用默认占位符（仅限本地/演示，生产必须改为强随机密钥）

HANDY_MASTER_SECRET=change-me-docker-dev-only

# CORS allowed origins (comma-separated). Defaults to localhost dev ports if unset.
# Example: ALLOWED_ORIGINS=https://happy.example.com,https://app.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
