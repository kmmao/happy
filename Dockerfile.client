# Happy CLI Client Container
# Ubuntu with Claude Code + happy-coder, single-user instance

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV SHELL=/usr/bin/zsh

# Switch to Aliyun mirror for faster downloads
RUN sed -i 's|http://ports.ubuntu.com|http://mirrors.aliyun.com|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || \
    sed -i 's|http://ports.ubuntu.com|http://mirrors.aliyun.com|g' /etc/apt/sources.list 2>/dev/null || true

# System dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    zsh \
    tmux \
    sudo \
    ca-certificates \
    gnupg \
    vim \
    ripgrep \
    fd-find \
    jq \
    htop \
    unzip \
    gosu \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s $(which fdfind) /usr/local/bin/fd

# Install Node.js 20 via NodeSource
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install ttyd (web terminal)
RUN apt-get update && apt-get install -y ttyd && rm -rf /var/lib/apt/lists/*

# Use npm mirror for faster downloads
RUN npm config set registry https://registry.npmmirror.com

# Install happy-coder globally (use official registry to get latest version)
RUN npm install -g @kmmao/happy-coder --registry https://registry.npmjs.org

# Create non-root user (Claude Code refuses --dangerously-skip-permissions as root)
RUN useradd -m -s /usr/bin/zsh -G sudo coder && \
    echo 'coder ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

# Switch to coder user for remaining setup
USER coder
WORKDIR /home/coder

# Install Oh My Zsh
RUN sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended

# Zsh plugins
RUN git clone https://github.com/zsh-users/zsh-autosuggestions ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-autosuggestions \
    && git clone https://github.com/zsh-users/zsh-syntax-highlighting ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting \
    && git clone https://github.com/zsh-users/zsh-completions ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-completions \
    && sed -i 's/plugins=(git)/plugins=(git zsh-autosuggestions zsh-syntax-highlighting zsh-completions node npm)/' ~/.zshrc

# Install Claude Code CLI (as coder user)
RUN curl -fsSL https://claude.ai/install.sh | bash

# Configure PATH and aliases
RUN echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.zshrc && \
    echo 'alias claude="claude --dangerously-skip-permissions"' >> ~/.zshrc

# Pre-configure Claude Code for non-interactive/SDK usage
RUN mkdir -p /home/coder/.claude && \
    echo '{"agreed": true}' > /home/coder/.claude/.agreed-tos && \
    echo '{"primaryApiKey":"any","hasCompletedOnboarding":true}' > /home/coder/.claude/settings.json

# Pre-install everything-claude-code plugin
RUN mkdir -p /home/coder/.claude/plugins/cache/everything-claude-code/everything-claude-code \
    /home/coder/.claude/plugins/marketplaces && \
    git config --global --add safe.directory '*' && \
    git clone --depth 1 https://github.com/anthropics/claude-plugins-official.git \
        /home/coder/.claude/plugins/marketplaces/claude-plugins-official && \
    git clone --depth 1 https://github.com/kmmao/everything-claude-code.git \
        /home/coder/.claude/plugins/marketplaces/everything-claude-code && \
    ECC_SHA=$(git -C /home/coder/.claude/plugins/marketplaces/everything-claude-code rev-parse HEAD) && \
    ECC_VER=$(grep -o '"version": *"[^"]*"' /home/coder/.claude/plugins/marketplaces/everything-claude-code/package.json | head -1 | grep -o '"[^"]*"$' | tr -d '"' || echo "latest") && \
    cp -r /home/coder/.claude/plugins/marketplaces/everything-claude-code \
        /home/coder/.claude/plugins/cache/everything-claude-code/everything-claude-code/$ECC_VER && \
    printf '{"version":2,"plugins":{"everything-claude-code@everything-claude-code":[{"scope":"user","installPath":"/home/coder/.claude/plugins/cache/everything-claude-code/everything-claude-code/%s","version":"%s","installedAt":"2026-01-01T00:00:00.000Z","lastUpdated":"2026-01-01T00:00:00.000Z","gitCommitSha":"%s"}]}}' \
        "$ECC_VER" "$ECC_VER" "$ECC_SHA" > /home/coder/.claude/plugins/installed_plugins.json && \
    echo '{"everything-claude-code":{"source":{"source":"github","repo":"kmmao/everything-claude-code"},"installLocation":"/home/coder/.claude/plugins/marketplaces/everything-claude-code","autoUpdate":true},"claude-plugins-official":{"source":{"source":"github","repo":"anthropics/claude-plugins-official"},"installLocation":"/home/coder/.claude/plugins/marketplaces/claude-plugins-official","autoUpdate":true}}' \
        > /home/coder/.claude/plugins/known_marketplaces.json && \
    mkdir -p /home/coder/.claude/rules && \
    cp /home/coder/.claude/plugins/marketplaces/everything-claude-code/rules/common/*.md /home/coder/.claude/rules/ && \
    cp /home/coder/.claude/plugins/marketplaces/everything-claude-code/rules/typescript/*.md /home/coder/.claude/rules/ 2>/dev/null || true

# Happy configuration
ENV HAPPY_SERVER_URL="https://s.sangreal.code.xycloud.info:2443"
ENV HAPPY_WEBAPP_URL="http://localhost:8081"
ENV HAPPY_HOME_DIR="/home/coder/.happy"
ENV EXPO_PACKAGER_PROXY_URL="http://localhost:8081"
# ANTHROPIC_BASE_URL and ANTHROPIC_AUTH_TOKEN are passed at runtime via docker run -e
# Do NOT bake API keys into the image

# Entrypoint script (write as root, then switch back)
USER root
RUN cat > /usr/local/bin/happy-entrypoint.sh << 'SCRIPT'
#!/bin/bash
set -e

# Disable sudo if requested (must run as root before switching to coder)
if [ "$DISABLE_SUDO" = "1" ]; then
    sed -i '/^coder/d' /etc/sudoers
fi

# Pass all environment variables to coder user and run as coder
exec gosu coder bash -c '
export PATH="$HOME/.local/bin:$PATH"
export HOME=/home/coder

# Clean stale daemon state from previous container run
rm -f "${HAPPY_HOME_DIR:-$HOME/.happy}/daemon.state.json"
rm -f "${HAPPY_HOME_DIR:-$HOME/.happy}/daemon.state.json.lock"

# Start ttyd (web terminal) on port 7681 in /work
cd /work
TTYD_ARGS="-p 7681 -W"
if [ -n "$TTYD_CREDENTIAL" ]; then
    TTYD_ARGS="$TTYD_ARGS -c $TTYD_CREDENTIAL"
fi
ttyd $TTYD_ARGS zsh &

# Start happy daemon (foreground)
exec happy daemon start-sync
'
SCRIPT
RUN chmod +x /usr/local/bin/happy-entrypoint.sh

# Create work directory with correct ownership
RUN mkdir -p /work && chown coder:coder /work
RUN mkdir -p /home/coder/.happy && chown coder:coder /home/coder/.happy

# Default working directory
WORKDIR /work

# Persist happy data and work directory
VOLUME /home/coder/.happy
VOLUME /work

# Expose ttyd web terminal port
EXPOSE 7681

CMD ["happy-entrypoint.sh"]

# ============================================================
# Usage
# ============================================================
#
# 1. 构建镜像
#
#    docker build -f Dockerfile.client -t happy-client .
#
# 2. 启动容器（Provision Token — 免扫码，推荐）
#
#    docker run -d --name happy-user \
#      --hostname user \
#      --network happy_default \
#      -v happy-user-data:/home/coder/.happy \
#      -v happy-user-work:/work \
#      -p 7001:7681 \
#      -e HAPPY_PROVISION_TOKEN="hp_xxxxxxxx" \
#      happy-client
#
# 3. Web 终端访问
#
#    浏览器打开 http://localhost:7001
#
# 4. 进入已运行的容器
#
#    docker exec -it -u coder happy-user zsh
#
# ============================================================
