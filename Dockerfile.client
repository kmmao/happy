# Happy CLI Client Container
# Ubuntu with Claude Code + happy-coder, single-user instance

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV SHELL=/usr/bin/zsh

# Happy configuration (override at runtime with -e)
ENV HAPPY_SERVER_URL="http://localhost:3005"
ENV HAPPY_WEBAPP_URL="http://localhost:8081"
ENV HAPPY_HOME_DIR="/root/.happy"
ENV EXPO_PACKAGER_PROXY_URL="http://localhost:8081"

ENV ANTHROPIC_BASE_URL="http://100.85.22.83:8899"
ENV ANTHROPIC_AUTH_TOKEN="sk-eed38d0404ac17a70e24474024cf9cc56b56a0cea3bf8e1c196f0fb1253a7eb0"

# System dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    zsh \
    tmux \
    sudo \
    ca-certificates \
    gnupg \
    vim \
    ripgrep \
    fd-find \
    jq \
    htop \
    unzip \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s $(which fdfind) /usr/local/bin/fd

# Install Node.js 20 via NodeSource
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Oh My Zsh (non-interactive)
RUN sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended

# Zsh plugins
RUN git clone https://github.com/zsh-users/zsh-autosuggestions ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-autosuggestions \
    && git clone https://github.com/zsh-users/zsh-syntax-highlighting ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting \
    && git clone https://github.com/zsh-users/zsh-completions ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-completions \
    && sed -i 's/plugins=(git)/plugins=(git zsh-autosuggestions zsh-syntax-highlighting zsh-completions node npm)/' ~/.zshrc

# Install ttyd (web terminal)
RUN apt-get update && apt-get install -y ttyd && rm -rf /var/lib/apt/lists/*

# Install happy-coder globally
RUN npm install -g @kmmao/happy-coder

# Install Claude Code CLI
RUN curl -fsSL https://claude.ai/install.sh | bash

# Configure PATH for Claude CLI
RUN echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.zshrc

# Happy environment variables are set via Docker ENV (see above)
# No need to hardcode in .zshrc — docker passes ENV to all shells

# Set zsh as default shell
RUN chsh -s /usr/bin/zsh

# Entrypoint script: starts happy daemon + ttyd in background
RUN cat > /usr/local/bin/happy-entrypoint.sh << 'SCRIPT'
#!/bin/bash
set -e

# Source zsh profile for PATH
export PATH="$HOME/.local/bin:$PATH"

# Start ttyd (web terminal) on port 7681 in /work
cd /work
ttyd -p 7681 -W zsh &

# Start happy daemon (foreground, auto-authenticates with HAPPY_PROVISION_TOKEN)
exec happy daemon start-sync
SCRIPT
RUN chmod +x /usr/local/bin/happy-entrypoint.sh

# Default working directory
RUN mkdir -p /work
WORKDIR /work

# Persist happy data and work directory
VOLUME /root/.happy
VOLUME /work

# Expose ttyd web terminal port
EXPOSE 7681

CMD ["happy-entrypoint.sh"]

# ============================================================
# Usage
# ============================================================
#
# 1. 构建镜像
#
#    docker build -f Dockerfile.client -t happy-client .
#
# 2. 启动容器（手动认证 — 需要扫码）
#
#    docker run -it --name happy-user \
#      -v happy-data:/root/.happy \
#      happy-client
#
#    容器内运行 happy，然后用 App 扫 QR 码完成认证。
#
# 3. 启动容器（Provision Token — 免扫码，推荐）
#
#    在 Happy App 设置 → Provision Tokens → 创建，复制 token 后：
#
#    docker run -d --name happy-user \
#      -v happy-data:/root/.happy \
#      -e HAPPY_PROVISION_TOKEN="hp_xxxxxxxx" \
#      happy-client sleep infinity
#
#    容器启动后自动完成认证，无需扫码。
#    Token 仅首次启动时需要，认证信息保存在数据卷中。
#
# 3b. 自定义 Server URL + Provision Token
#
#    docker run -d --name happy-user \
#      -v happy-data:/root/.happy \
#      -e HAPPY_PROVISION_TOKEN="hp_xxxxxxxx" \
#      -e HAPPY_SERVER_URL="https://my-server.example.com" \
#      -e HAPPY_WEBAPP_URL="https://my-webapp.example.com" \
#      happy-client sleep infinity
#
# 4. 进入已运行的容器
#
#    docker exec -it happy-user zsh
#
# 5. 容器内使用
#
#    happy             # 启动 happy-coder
#    claude            # 启动 Claude Code
#    tmux              # 使用 tmux 管理多会话
#
# 6. 停止 / 重启
#
#    docker stop happy-user
#    docker start -i happy-user
#
# 7. 重建容器（数据卷保留，无需重新认证）
#
#    docker rm -f happy-user
#    docker run -d --name happy-user \
#      -v happy-data:/root/.happy \
#      happy-client sleep infinity
#
# 8. 彻底清除（删除容器 + 数据卷）
#
#    docker rm -f happy-user
#    docker volume rm happy-data
#
# ============================================================
